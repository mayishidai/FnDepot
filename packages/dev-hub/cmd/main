#!/bin/bash
# Dev Hub 的启停由应用中心通过 docker compose 管理，这里只负责回报状态。

FILE_PATH="${TRIM_APPDEST}/docker/docker-compose.yaml"

is_docker_running () {
    DOCKER_NAME=""

    if [ -f "$FILE_PATH" ]; then
        DOCKER_NAME=$(grep "container_name" "$FILE_PATH" | awk -F ':' '{print $2}' | xargs)
    fi

    if [ -n "$DOCKER_NAME" ]; then
        docker inspect "$DOCKER_NAME" | grep -q "\"Status\": \"running\"," || exit 1
        return
    fi
}

case $1 in
start)
    # 容器由应用中心启动，面板启动后会自行拉起配置了自启的子应用
    exit 0
    ;;
stop)
    exit 0
    ;;
status)
    # 0 = 运行中，3 = 未运行
    if is_docker_running; then
        exit 0
    else
        exit 3
    fi
    ;;
*)
    exit 1
    ;;
esac
