#!/bin/bash
# 安装「之前」执行：校验安装向导收集的管理员账号。
# 这里拦下的输入不会走到 install_callback，也就不会写进 fnos-admin.env。
#
# 规则与 octop init 的密码策略保持一致：≥8 位且必须同时含字母与数字。
# 官方 entrypoint 已经修掉了「弱密码让 init 失败、容器反复重启」（issue #502），
# 但那兜底是**悄悄换成随机密码**，用户拿着自己设的密码会登不进去，
# 所以在安装前明确拦一次比事后排查便宜得多。

fail_init () {
    echo "[octop] $1" > "${TRIM_TEMP_LOGFILE:-/dev/null}" 2>&1 || true
    echo "[octop] $1" >&2 || true
    exit 1
}

ADMIN_USER="${wizard_admin_username:-}"
ADMIN_PASS="${wizard_admin_password:-}"
ADMIN_CONFIRM="${wizard_admin_password_confirm:-}"

[ -n "$ADMIN_USER" ] || fail_init "请输入管理员用户名"

# 用户名规则与 wizard/install 里的 pattern 一致（2-32 位，首字符字母或数字）
printf '%s' "$ADMIN_USER" | grep -Eq '^[a-zA-Z0-9][a-zA-Z0-9_.-]{1,31}$' \
    || fail_init "用户名只能包含字母、数字、点、下划线和连字符（2-32 位，且以字母或数字开头）"

[ "${#ADMIN_PASS}" -ge 8 ] || fail_init "密码至少 8 位"
printf '%s' "$ADMIN_PASS" | grep -q '[A-Za-z]' || fail_init "密码必须包含字母"
printf '%s' "$ADMIN_PASS" | grep -q '[0-9]' || fail_init "密码必须包含数字"
[ "$ADMIN_PASS" = "$ADMIN_CONFIRM" ] || fail_init "两次输入的密码不一致"

exit 0
