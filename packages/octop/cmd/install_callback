#!/bin/bash
# 安装「之后」执行：把安装向导收集的管理员凭据写进凭据文件。
#
# 写在哪：/var/apps/octop/shares/data/fnos-admin.env
#   ★ 这个路径必须与 app/docker/docker-compose.yaml 里挂到容器 /data 的那一行
#     **逐字一致**。容器内的入口垫片只认 /data/fnos-admin.env，写错位置等于没写；
#     所以这里刻意写死、不从 TRIM_APPDEST 反推 —— 反推出来的路径一旦和 compose
#     的那一行不一样，症状会是「密码被忽略、用户拿着自己设的密码登不进去」，
#     而且很难从日志看出来。要改就两处一起改。
#   data-share 由 config/resource 声明，卸载应用时不会删，重装也能接着用。
#
# 之后**不需要**我们自己跑 octop init —— 官方镜像的 entrypoint
# （docker/docker-entrypoint.sh）会在容器首次启动时完成初始化，然后直接 run。
# 本文件只在「还没有 octop.db」时起作用；之后改密请在 Web 控制台里做。

set -euo pipefail

# 向导字段可能带回车（Windows 客户端复制粘贴），去掉避免写坏 env 文件
sanitize () { printf '%s' "${1:-}" | tr -d '\r\n'; }

ADMIN_USER="$(sanitize "${wizard_admin_username:-}")"
ADMIN_DISPLAY="$(sanitize "${wizard_admin_display_name:-}")"
ADMIN_PASS="$(sanitize "${wizard_admin_password:-}")"

[ -n "$ADMIN_USER" ] || ADMIN_USER="admin"

DATA_DIR="/var/apps/octop/shares/data"
mkdir -p "$DATA_DIR"

ENV_FILE="${DATA_DIR}/fnos-admin.env"
{
    echo "OCTOP_ADMIN_USERNAME=${ADMIN_USER}"
    echo "OCTOP_ADMIN_DISPLAY_NAME=${ADMIN_DISPLAY}"
    echo "OCTOP_DEFAULT_PASSWORD=${ADMIN_PASS}"
} > "$ENV_FILE"

# 含明文密码，收紧权限
chmod 600 "$ENV_FILE"

echo "[octop] 管理员凭据已写入 ${ENV_FILE}（用户名 ${ADMIN_USER}）" \
    > "${TRIM_TEMP_LOGFILE:-/dev/null}" 2>/dev/null || true

exit 0
